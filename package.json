{
  "name": "polymarket-quant-lab",
  "version": "0.1.0",
  "description": "Autonomous Market Research, Strategy Discovery, Backtesting, and Paper-Trading Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "node dist/db/migrate.js",
    "db:reset": "node dist/db/reset.js",
    "ci": "npm run type-check && npm run lint && npm run build && npm run test"
  },
  "keywords": ["quantitative-trading", "backtesting", "paper-trading", "polymarket"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-postgres": "^0.6.2",
    "pg": "^8.11.3",
    "pg-migrate": "^4.4.6",
    "pino": "^8.16.2",
    "pino-http": "^8.5.0",
    "typescript": "^5.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.51.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
